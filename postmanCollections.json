    "item": [
        {
            "name": "Force Integration Callback",
            "item": [
                {
                    "name": "Notes to update callback",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "Do the \"Retrieve All Integration Executions\" first. Find your problem Integration. \r\nUse the \"ID\" of the integration in the response as the \"ID\" in the \"Force Integration Completed\" request. \r\nUse the \"IntegrationId\" in the response as the \"ExecutionId\" in the \"Force Integration Completed\" request"
                        },
                        "url": {
                            "raw": ""
                        },
                        "description": "ID = ID\r\nIntegrationId = ExecutionId"
                    },
                    "response": []
                },
                {
                    "name": "Retrieve All Integration Executions",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "{{access_token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{url}}/api/v1/platform/integration_executions",
                            "host": [
                                "{{url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "platform",
                                "integration_executions"
                            ],
                            "query": [
                                {
                                    "key": "fromDate",
                                    "value": "",
                                    "disabled": true
                                },
                                {
                                    "key": "toDate",
                                    "value": "",
                                    "disabled": true
                                },
                                {
                                    "key": "IntegrationId",
                                    "value": "",
                                    "disabled": true
                                }
                            ]
                        },
                        "description": "This operation returns a list of all integration runs including completed, in-progress, scheduled, and failed integration runs. The list shows details including start and end times, parameter settings, which employee ran each integration, and the status. You can filter the integration runs. To retrieve integrations from the past four days, filter by integrationId alone. Otherwise, you must filter by integrationId, fromDate, and toDate.\r\n"
                    },
                    "response": []
                },
                {
                    "name": "Force Integration Completed",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            },
                            {
                                "key": "Authorization",
                                "value": "{{access_token}}",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"batchIntegration\": {\n    \"callbackmessages\": \"Integration has been beaten into submission\",\n    \"executionid\": \"434\",\n    \"id\": 763,\n    \"status\": \"Completed\"\n  }\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{url}}/api/v1/platform/integrations/update_status",
                            "host": [
                                "{{url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "platform",
                                "integrations",
                                "update_status"
                            ]
                        },
                        "description": "Do the \"Retrieve All Integration Executions\" first.  Find your problem Integration.  Use the ID of the integration in the response as the ID in the \"Force Integration Completed\" request.   Use the IntegrationId in the response as the ExecutionId in the \"Force Integration Completed\" request"
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Get an Access Token",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "var jsonData = JSON.parse(responseBody);",
                            "postman.setEnvironmentVariable(\"access_token\", jsonData.access_token);",
                            "postman.setEnvironmentVariable(\"refresh_token\", jsonData.refresh_token);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "auth": {
                    "type": "noauth"
                },
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/x-www-form-urlencoded"
                    }
                ],
                "body": {
                    "mode": "urlencoded",
                    "urlencoded": [
                        {
                            "key": "username",
                            "value": "{{username}}",
                            "type": "text"
                        },
                        {
                            "key": "password",
                            "value": "{{password}}",
                            "type": "text"
                        },
                        {
                            "key": "client_id",
                            "value": "{{client_id}}",
                            "type": "text"
                        },
                        {
                            "key": "client_secret",
                            "value": "{{client_secret}}",
                            "type": "text"
                        },
                        {
                            "key": "grant_type",
                            "value": "password",
                            "type": "text"
                        }
                    ]
                },
                "url": {
                    "raw": "{{url}}/api/authentication/access_token",
                    "host": [
                        "{{url}}"
                    ],
                    "path": [
                        "api",
                        "authentication",
                        "access_token"
                    ]
                }
            },
            "response": []
        },
