{
  "name": "radius-monorepo",
  "version": "1.1.0",
  "description": "Radius - Git-friendly API Client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @radius/gui dev",
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @radius/core build",
    "build:cli": "pnpm --filter @radius/cli build",
    "build:gui": "pnpm --filter @radius/gui build",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @radius/core test",
    "test:cli": "pnpm --filter @radius/cli test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean"
  },
  "keywords": [
    "api",
    "http",
    "request",
    "runner",
    "postman",
    "gui"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}